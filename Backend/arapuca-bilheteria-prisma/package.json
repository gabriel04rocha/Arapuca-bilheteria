{
  "name": "arapuca-bilheteria-prisma",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "npm run build && npm run composer:deploy",
    "dev": "turbo run dev",
    "dev:composer": "npm run build && npm run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "start": "turbo run start",
    "typecheck": "tsc --noEmit && turbo run typecheck"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/node": "^25.6.2",
    "prisma": "8.0.0-rc.15",
    "turbo": "2.10.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/composer": "0.20.0",
    "@prisma/composer-prisma-cloud": "0.20.0",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "alchemy": "2.0.0-beta.74"
  },
  "overrides": {
    "effect": "4.0.0-rc.112"
  }
}
